{
  "expo": {
    "name": "Zuri",
    "slug": "LexiMobile",
    "owner": "zurilearn.com",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "leximobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.oladraxler.leximobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#17231b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zurilearn.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17231b",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Zuri uses the microphone to record your lectures when you tap record.",
          "enableBackgroundRecording": true
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/"
        }
      ],
      "@sentry/react-native",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Zuri uses the microphone to record and transcribe your lectures when you tap record.",
          "speechRecognitionPermission": "Zuri turns the lecture into text as it happens, so you get a transcript and notes.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9e1b0843-035e-4489-9fbc-169b633c344b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9e1b0843-035e-4489-9fbc-169b633c344b",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    }
  }
}
