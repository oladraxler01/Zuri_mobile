# Zuri environment configuration
# Copy this file to .env. Only variables starting with EXPO_PUBLIC_ are readable by the app,
# and they are bundled into it, so never put secret keys here.

# Zuri API gateway (REST API is served under /api/v1, health check at /health)
EXPO_PUBLIC_API_GATEWAY_URL=https://api.zurilearn.com

# Send lectures/materials to the live server (needs a signed-in user).
# Set to false to use the on-phone stand-ins instead, e.g. for offline demos.
EXPO_PUBLIC_USE_LIVE_API=true

# Environment mode: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Crash reporting (Sentry). Leave empty to turn reporting off (local, CI).
# A DSN is safe to bundle; it only allows sending events. Set it per EAS profile.
EXPO_PUBLIC_SENTRY_DSN=

# Shows /dev/design-system (component gallery + "Send test error") outside dev.
# eas.json sets it for development and preview builds.
EXPO_PUBLIC_DIAGNOSTICS=
