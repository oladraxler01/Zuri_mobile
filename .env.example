# Lexi Mobile Environment Configuration Example
# Copy this file to .env and adjust variables to match your environment.

# Base URL for the Lexi backend REST API
EXPO_PUBLIC_API_BASE_URL=https://api.lexi.yourdomain.com/v1

# WebSocket endpoint for real-time speech / lecture streaming & chat
EXPO_PUBLIC_WS_BASE_URL=wss://api.lexi.yourdomain.com/ws

# Environment mode: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Optional: Direct Audio Service key if testing client-direct transcription (recommended via backend proxy)
# EXPO_PUBLIC_GROQ_API_KEY=
